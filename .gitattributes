# ============================================================
# COPYROOM - Git attributes and Git LFS rules
# ============================================================

# Normalize text files while preserving binary files
* text=auto

# Text formats
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.cs text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cpp text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unreal binary assets
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text

# 3D source assets
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.abc filter=lfs diff=lfs merge=lfs -text
*.usd filter=lfs diff=lfs merge=lfs -text
*.usda filter=lfs diff=lfs merge=lfs -text
*.usdc filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.ztl filter=lfs diff=lfs merge=lfs -text
*.spp filter=lfs diff=lfs merge=lfs -text

# Textures and source artwork
